# ==========================================
# DomainBot Configuration
# ==========================================

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Authorized Admin Telegram User IDs (Comma-separated)
# Only users with these IDs can manage domains (add, delete, sync)
ADMIN_IDS=123456789,987654321

# Allowed Telegram Group / Supergroup IDs (Optional)
# If set, bot only responds in these groups and in private chats with admins.
# Leave empty to allow any group where an admin invokes it.
# Note: Group IDs usually start with a minus, e.g. -1001234567890
ALLOWED_GROUP_IDS=-1001234567890

# Target Chat ID for daily automated expiration alerts
# Can be your personal user ID or a group ID
ALERT_CHAT_ID=-1001234567890

# Target Topic / Thread ID (Optional)
# If ALERT_CHAT_ID is a forum supergroup, specify the topic ID (message_thread_id) here.
# Leave blank or commented out if posting to General or a regular group/DM.
ALERT_THREAD_ID=1234

# Scheduled Daily Alert Time (Cron format)
# Default: '0 8 * * *' (Every day at 08:00 AM)
ALERT_CRON=0 8 * * *

# Expiration Alert Thresholds in days (Descending, comma-separated)
ALERT_THRESHOLDS=60,30,14,7,3,1,0

# Background Auto-Checker Interval in milliseconds (Default: 12000 / 12 seconds)
BACKGROUND_CHECK_INTERVAL_MS=12000

# Timezone for alert scheduling
TIMEZONE=Asia/Jakarta
